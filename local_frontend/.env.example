# Local Frontend Configuration
# Port on which the frontend development server will run
PORT=3030

# Host configuration for the development server
HOST=localhost

# Node environment
NODE_ENV=development

# API Configuration - Local Backend Only
# Base URL for all API requests to the local backend
VITE_API_URL=http://localhost:8080/api

# Biometric device service configuration for Mantra MFS100
# Use the local RD Service URL exposed by the MFS100 SDK.
VITE_BIOMETRIC_DEVICE_URL=http://localhost:11100
VITE_BIOMETRIC_DEVICE_CAPTURE_URL=http://localhost:11100/RDServiceMFS100
VITE_BIOMETRIC_DEVICE_TEST_URL=http://localhost:11100/RDServiceMFS100
