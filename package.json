{
  "name": "digi-biometric-desktop",
  "productName": "Digi Biometric System",
  "version": "1.0.0",
  "description": "Professional Biometric Verification System for Examinations",
  "main": "electron/main.js",
  "author": "Digi Biometric Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "electron:dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\" \"wait-on http://localhost:3030 && electron .\"",
    "electron:start": "electron .",
    "backend:dev": "cd local_backend && npm run dev",
    "frontend:dev": "cd local_frontend && npm run dev",
    "backend:build": "cd local_backend && npm install --production",
    "frontend:build": "cd local_frontend && npm run build",
    "build": "npm run frontend:build && npm run backend:build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable",
    "install-all": "npm install && cd local_backend && npm install && cd ../local_frontend && npm install",
    "build:complete": "node scripts/build-working.js",
    "fix-build": "node scripts/fix-build.js",
    "rebuild-fixed": "node scripts/rebuild-fixed.js",
    "build-simple": "node scripts/build-simple.js",
    "postinstall": "electron-builder install-app-deps"
  },
    "build": {
      "extends": "electron-builder.json"
    },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.13.6",
    "dotenv": "^16.3.1",
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  }
}
