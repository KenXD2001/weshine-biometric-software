# Server Configuration
PORT=8080
NODE_ENV=development

# Cloud Backend Configuration
CLOUD_BACKEND_URL=http://localhost:8040
LOCAL_BACKEND_ID=local-biometric-center-1

# Sync Configuration
SYNC_INTERVAL_MS=300000      # 5 minutes
RETRY_INTERVAL_MS=60000     # 1 minute
CONNECTION_CHECK_MS=30000   # 30 seconds

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Database Configuration (if needed later)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=digi_biometric
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# API Configuration
API_VERSION=v1

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads
