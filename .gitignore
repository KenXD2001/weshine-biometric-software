# Dependencies
node_modules/
local_frontend/node_modules/
local_backend/node_modules/

# Build outputs and distributions
dist/
build/
local_frontend/dist/
local_frontend/build/
dist-electron/
electron/backend-bundle.js

# Electron build artifacts
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.snap
*.appimage
release/
out/
*.asar

# Environment files (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
local_backend/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage and testing
coverage/
*.lcov
.nyc_output

# Cache directories
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# TypeScript
*.tsbuildinfo

# Package manager files
*.tgz
.yarn-integrity

# Temporary files
tmp/
temp/
*~
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories
.vscode/
.idea/

# Generated data files (keep structure, ignore content)
local_backend/data/*.json
!local_backend/data/.gitkeep

# Uploads (keep directory structure)
local_backend/uploads/*
!local_backend/uploads/.gitkeep

# Ignore temp sync and fallback user data
local_backend/.temp-sync/
local_backend/user_data_fallback/

# Test files that shouldn't be committed
test.json

# Lock files - uncomment if you want to ignore them
# package-lock.json
# local_frontend/package-lock.json
# local_backend/package-lock.json
